# Generated by tools/start-printflow.ps1. Never commit .env.
PRINTFLOW_BRIDGE_TOKEN=replace-with-a-long-random-local-token
# Native Windows host is still required to use Snapmaker Orca and signed-in Codex.
PRINTFLOW_VERSION=0.3.0
PRINTFLOW_GPU_PROFILE=cpu
PRINTFLOW_HOST_URL=http://host.docker.internal:8841
# For WSL Engine, set this to the Windows host address reachable from WSL.

# Optional operator-managed SearXNG URL (JSON search enabled). Blank uses the host-connected Codex web search.
PRINTFLOW_SEARCH_URL=
